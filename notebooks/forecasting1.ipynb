import json
from pathlib import Path

def make_code_cell(source):
    return {
        "cell_type": "code",
        "execution_count": None,
        "metadata": {},
        "outputs": [],
        "source": source.strip("\n").splitlines(True)
    }

def make_markdown_cell(source):
    return {
        "cell_type": "markdown",
        "metadata": {},
        "source": source.strip("\n").splitlines(True)
    }

cells = []

cells.append(make_markdown_cell("""
# Business Analytics Forecasting — Colab Notebook

This notebook contains practical forecasting snippets for business analytics students.

Use cases:
- Sales forecasting
- Demand forecasting
- Revenue forecasting
- Customer volume forecasting
- Transaction volume forecasting

Expected dataset structure:
- One date column, for example `date`, `month`, `posting_date`
- One numeric target column, for example `sales`, `revenue`, `demand`, `customers`
"""))

cells.append(make_code_cell("""
# Install packages
!pip -q install statsmodels xgboost

import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import mean_absolute_error, mean_squared_error, mean_absolute_percentage_error
from sklearn.ensemble import RandomForestRegressor
from xgboost import XGBRegressor

from statsmodels.tsa.statespace.sarimax import SARIMAX
from statsmodels.graphics.tsaplots import plot_acf, plot_pacf
"""))

cells.append(make_markdown_cell("""
## 1. Load your data
Run this cell and upload a CSV file from your computer.
"""))

cells.append(make_code_cell("""
from google.colab import files

uploaded = files.upload()
filename = list(uploaded.keys())[0]

df_raw = pd.read_csv(filename)
df_raw.head()
"""))

cells.append(make_markdown_cell("""
## 2. Choose the date column and the forecasting target

Change `DATE_COL` and `TARGET_COL` to match your dataset.
"""))

cells.append(make_code_cell("""
DATE_COL = "date"       # change this, e.g. "month", "posting_date", "invoice_date"
TARGET_COL = "sales"    # change this, e.g. "revenue", "demand", "customers"
FREQ = "M"              # "D" = daily, "W" = weekly, "M" = monthly

df = df_raw.copy()

df[DATE_COL] = pd.to_datetime(df[DATE_COL], errors="coerce")
df[TARGET_COL] = pd.to_numeric(df[TARGET_COL], errors="coerce")

df = (
    df.dropna(subset=[DATE_COL, TARGET_COL])
      .sort_values(DATE_COL)
      .set_index(DATE_COL)
)

# Aggregate by period
ts = df[TARGET_COL].resample(FREQ).sum().asfreq(FREQ)

# Fill missing periods
ts = ts.interpolate()

ts.head()
"""))

cells.append(make_markdown_cell("""
## 3. Visualize the time series
"""))

cells.append(make_code_cell("""
plt.figure(figsize=(14, 5))
plt.plot(ts.index, ts.values, linewidth=2)
plt.title(f"{TARGET_COL} over time")
plt.xlabel("Date")
plt.ylabel(TARGET_COL)
plt.grid(alpha=0.3)
plt.show()
"""))

cells.append(make_markdown_cell("""
## 4. Inspect autocorrelation

ACF helps reveal whether previous periods influence the present.
This is useful for choosing lag features and detecting seasonality.
"""))

cells.append(make_code_cell("""
fig, ax = plt.subplots(figsize=(12, 4))
plot_acf(ts.dropna(), lags=min(36, max(1, len(ts)//2)), ax=ax)
plt.title("ACF: correlation with previous periods")
plt.show()

fig, ax = plt.subplots(figsize=(12, 4))
plot_pacf(ts.dropna(), lags=min(24, max(1, len(ts)//3)), ax=ax, method="ywm")
plt.title("PACF: direct lag effects")
plt.show()
"""))

cells.append(make_markdown_cell("""
## 5. Train/test split

For time series, never shuffle the data. The model should train on the past and predict the future.
"""))

cells.append(make_code_cell("""
train_size = int(len(ts) * 0.8)

train = ts.iloc[:train_size]
test = ts.iloc[train_size:]

plt.figure(figsize=(14, 5))
plt.plot(train.index, train, label="Train", linewidth=2)
plt.plot(test.index, test, label="Test", linewidth=2)
plt.axvline(train.index[-1], linestyle="--", label="Split")
plt.title("Time-based train/test split")
plt.xlabel("Date")
plt.ylabel(TARGET_COL)
plt.legend()
plt.grid(alpha=0.3)
plt.show()

print("Train period:", train.index.min(), "to", train.index.max())
print("Test period:", test.index.min(), "to", test.index.max())
"""))

cells.append(make_markdown_cell("""
## 6. Evaluation functions

MAE is easy to explain to managers. RMSE penalizes large errors. MAPE expresses error as a percentage.
"""))

cells.append(make_code_cell("""
def evaluate_forecast(y_true, y_pred, model_name):
    y_true = pd.Series(y_true).astype(float)
    y_pred = pd.Series(y_pred, index=y_true.index).astype(float)
    
    return {
        "model": model_name,
        "MAE": mean_absolute_error(y_true, y_pred),
        "RMSE": np.sqrt(mean_squared_error(y_true, y_pred)),
        "MAPE (%)": mean_absolute_percentage_error(y_true, y_pred) * 100
    }

def plot_forecast(train, test, pred, title):
    plt.figure(figsize=(14, 5))
    plt.plot(train.index, train, label="Train")
    plt.plot(test.index, test, label="Actual", linewidth=2)
    plt.plot(test.index, pred, label="Forecast", linewidth=2)
    plt.title(title)
    plt.xlabel("Date")
    plt.ylabel(TARGET_COL)
    plt.legend()
    plt.grid(alpha=0.3)
    plt.show()
"""))

cells.append(make_markdown_cell("""
## 7. Baseline model

Always compare advanced models with a simple baseline.
"""))

cells.append(make_code_cell("""
naive_pred = pd.Series(train.iloc[-1], index=test.index)

baseline_result = evaluate_forecast(test, naive_pred, "Naive baseline")
plot_forecast(train, test, naive_pred, "Naive forecast: last observed value")

baseline_result
"""))

cells.append(make_markdown_cell("""
## 8. SARIMA model

SARIMA is useful when the series has trend and seasonality.
For monthly data, the seasonal period is usually 12.
"""))

cells.append(make_code_cell("""
SEASONAL_PERIOD = 12  # monthly seasonality

sarima = SARIMAX(
    train,
    order=(1, 1, 1),
    seasonal_order=(1, 1, 1, SEASONAL_PERIOD),
    enforce_stationarity=False,
    enforce_invertibility=False
)

sarima_fit = sarima.fit(disp=False)

sarima_forecast = sarima_fit.get_forecast(steps=len(test))
sarima_pred = sarima_forecast.predicted_mean
sarima_ci = sarima_forecast.conf_int()

sarima_result = evaluate_forecast(test, sarima_pred, "SARIMA")

plt.figure(figsize=(14, 5))
plt.plot(train.index, train, label="Train")
plt.plot(test.index, test, label="Actual", linewidth=2)
plt.plot(test.index, sarima_pred, label="SARIMA forecast", linewidth=2)
plt.fill_between(
    test.index,
    sarima_ci.iloc[:, 0],
    sarima_ci.iloc[:, 1],
    alpha=0.2,
    label="95% confidence interval"
)
plt.title("SARIMA forecast with uncertainty")
plt.xlabel("Date")
plt.ylabel(TARGET_COL)
plt.legend()
plt.grid(alpha=0.3)
plt.show()

sarima_result
"""))

cells.append(make_markdown_cell("""
## 9. Machine learning features

Random Forest and XGBoost do not understand time automatically.
We must create lag, rolling, and calendar features.
"""))

cells.append(make_code_cell("""
def make_time_features(series, max_lag=12, rolling_windows=(3, 6, 12)):
    data = pd.DataFrame({"y": series})
    
    for lag in range(1, max_lag + 1):
        data[f"lag_{lag}"] = data["y"].shift(lag)
    
    for window in rolling_windows:
        data[f"rolling_mean_{window}"] = data["y"].shift(1).rolling(window).mean()
        data[f"rolling_std_{window}"] = data["y"].shift(1).rolling(window).std()
    
    data["month"] = data.index.month
    data["quarter"] = data.index.quarter
    data["year"] = data.index.year
    data["time_index"] = np.arange(len(data))
    
    return data.dropna()

features = make_time_features(ts, max_lag=12)

X = features.drop(columns="y")
y = features["y"]

X_train = X.loc[train.index.min():train.index.max()]
y_train = y.loc[train.index.min():train.index.max()]

X_test = X.loc[test.index.min():test.index.max()]
y_test = y.loc[test.index.min():test.index.max()]

X_train.head()
"""))

cells.append(make_markdown_cell("""
## 10. Random Forest forecasting
"""))

cells.append(make_code_cell("""
rf = RandomForestRegressor(
    n_estimators=500,
    max_depth=8,
    min_samples_leaf=3,
    random_state=42
)

rf.fit(X_train, y_train)

rf_pred = pd.Series(rf.predict(X_test), index=X_test.index)

rf_result = evaluate_forecast(y_test, rf_pred, "Random Forest")
plot_forecast(train, y_test, rf_pred, "Random Forest forecast")

rf_result
"""))

cells.append(make_markdown_cell("""
## 11. XGBoost forecasting
"""))

cells.append(make_code_cell("""
xgb = XGBRegressor(
    n_estimators=500,
    max_depth=3,
    learning_rate=0.03,
    subsample=0.9,
    colsample_bytree=0.9,
    objective="reg:squarederror",
    random_state=42
)

xgb.fit(X_train, y_train)

xgb_pred = pd.Series(xgb.predict(X_test), index=X_test.index)

xgb_result = evaluate_forecast(y_test, xgb_pred, "XGBoost")
plot_forecast(train, y_test, xgb_pred, "XGBoost forecast")

xgb_result
"""))

cells.append(make_markdown_cell("""
## 12. Compare models
"""))

cells.append(make_code_cell("""
results = pd.DataFrame([
    baseline_result,
    sarima_result,
    rf_result,
    xgb_result
]).sort_values("RMSE")

results
"""))

cells.append(make_markdown_cell("""
## 13. Feature importance

This helps explain the forecast to business stakeholders.
"""))

cells.append(make_code_cell("""
importance = pd.Series(rf.feature_importances_, index=X_train.columns)
importance = importance.sort_values(ascending=False).head(15)

plt.figure(figsize=(10, 5))
importance.sort_values().plot(kind="barh")
plt.title("Top forecasting drivers")
plt.xlabel("Feature importance")
plt.grid(alpha=0.3)
plt.show()

importance
"""))

cells.append(make_markdown_cell("""
## 14. Future forecast and business scenarios

Use uncertainty intervals to create pessimistic, realistic, and optimistic scenarios.
"""))

cells.append(make_code_cell("""
HORIZON = 6

final_sarima = SARIMAX(
    ts,
    order=(1, 1, 1),
    seasonal_order=(1, 1, 1, SEASONAL_PERIOD),
    enforce_stationarity=False,
    enforce_invertibility=False
).fit(disp=False)

future = final_sarima.get_forecast(steps=HORIZON)

future_mean = future.predicted_mean
future_ci = future.conf_int()

scenario_table = pd.DataFrame({
    "pessimistic": future_ci.iloc[:, 0],
    "realistic": future_mean,
    "optimistic": future_ci.iloc[:, 1]
})

scenario_table
"""))

cells.append(make_code_cell("""
plt.figure(figsize=(14, 5))

plt.plot(ts.index, ts, label="Historical", linewidth=2)
plt.plot(future_mean.index, future_mean, label="Realistic forecast", linewidth=2)

plt.fill_between(
    future_mean.index,
    scenario_table["pessimistic"],
    scenario_table["optimistic"],
    alpha=0.2,
    label="Scenario range"
)

plt.title(f"Next {HORIZON} periods forecast")
plt.xlabel("Date")
plt.ylabel(TARGET_COL)
plt.legend()
plt.grid(alpha=0.3)
plt.show()
"""))

cells.append(make_markdown_cell("""
## 15. Executive summary generator
"""))

cells.append(make_code_cell("""
best_model = results.iloc[0]["model"]
best_rmse = results.iloc[0]["RMSE"]

expected_total = scenario_table["realistic"].sum()
low_total = scenario_table["pessimistic"].sum()
high_total = scenario_table["optimistic"].sum()

summary = f'''
Executive Forecast Summary

Best validation model: {best_model}
Validation RMSE: {best_rmse:,.2f}

Forecast horizon: next {HORIZON} periods

Expected total: {expected_total:,.0f}
Pessimistic total: {low_total:,.0f}
Optimistic total: {high_total:,.0f}

Business interpretation:
The realistic scenario should guide the main plan.
The pessimistic scenario should guide risk controls.
The optimistic scenario should guide capacity and inventory flexibility.
'''

print(summary)
"""))

